/**
 * @typedef {Object} Report
 * @property {string} id - unique report ID
 * @property {string} reporter_email - user who filed the report
 * @property {string} reported_item_type - "task" | "user" | "review" | "message"
 * @property {string} reported_item_id - ID of the reported item
 * @property {string} reported_user_email - email of the user being reported
 * @property {string} reason - "spam" | "inappropriate" | "fraud" | "harassment" | "other"
 * @property {string} [description] - optional additional details
 * @property {string} status - "pending" | "reviewed" | "resolved" | "dismissed"
 * @property {string} created_date - ISO timestamp
 */

export const ReportSchema = {
  type: "object",
  properties: {
    id: { type: "string" },
    reporter_email: { type: "string" },
    reported_item_type: { type: "string", enum: ["task", "user", "review", "message"] },
    reported_item_id: { type: "string" },
    reported_user_email: { type: "string" },
    reason: { type: "string", enum: ["spam", "inappropriate", "fraud", "harassment", "other"] },
    description: { type: "string" },
    status: { type: "string", enum: ["pending", "reviewed", "resolved", "dismissed"] },
    created_date: { type: "string", format: "date-time" }
  },
  required: ["reporter_email", "reported_item_type", "reported_item_id", "reported_user_email", "reason", "status", "created_date"]
};

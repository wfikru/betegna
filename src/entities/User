{
  "name": "User",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "User's email address (also used as login)"
    },
    "full_name": {
      "type": "string",
      "description": "Full name of the user"
    },
    "bio": {
      "type": "string",
      "description": "Short biography or description"
    },
    "phone": {
      "type": "string",
      "description": "Contact number"
    },
    "city": {
      "type": "string",
      "enum": [
        "addis_ababa",
        "dire_dawa",
        "hawassa",
        "bahir_dar",
        "adama",
        "mekelle",
        "jimma",
        "other"
      ],
      "default": "addis_ababa",
      "description": "City where the user is located"
    },
    "is_tasker": {
      "type": "boolean",
      "description": "Whether the user has enabled tasker mode",
      "default": false
    },
    "skills": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of task categories the user can perform"
    },
    "hourly_rate": {
      "type": "number",
      "description": "Requested rate per hour in ETB"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when profile was first created"
    }
  },
  "required": ["email"]
}
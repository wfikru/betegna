{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_email": {
      "type": "string",
      "description": "Email of the user who should receive the notification"
    },
    "type": {
      "type": "string",
      "enum": ["offer_made", "offer_accepted", "offer_rejected"],
      "description": "Type of notification"
    },
    "title": {
      "type": "string",
      "description": "Title/subject of the notification"
    },
    "message": {
      "type": "string",
      "description": "Detailed message content"
    },
    "task_id": {
      "type": "string",
      "description": "ID of the related task"
    },
    "task_title": {
      "type": "string",
      "description": "Title of the related task"
    },
    "offer_id": {
      "type": "string",
      "description": "ID of the related offer (if applicable)"
    },
    "actor_name": {
      "type": "string",
      "description": "Name of the user who triggered the notification"
    },
    "actor_email": {
      "type": "string",
      "description": "Email of the user who triggered the notification"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the notification has been read"
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the notification was created"
    }
  },
  "required": ["recipient_email", "type", "title", "message", "task_id", "created_date"]
}

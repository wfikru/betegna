# ── Betegna environment ─────────────────────────────────────────────
# App behavior
# "demo"  → runs on the bundled demo backend with seeded Ethiopian marketplace data (no Firebase needed)
# "firebase" → connects to your Firebase project using the config below
EXPO_PUBLIC_BACKEND_MODE=demo

# Firebase web config (required only when EXPO_PUBLIC_BACKEND_MODE=firebase)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Defaults (mobile push / deep links)
EXPO_PUBLIC_SUPPORT_PHONE=+251900000000
EXPO_PUBLIC_SUPPORT_EMAIL=support@betegna.app

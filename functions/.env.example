# Cloud Functions environment (set with: firebase functions:secrets/set or deploy --set-env-vars)
# PAYMENTS: cash only for launch
PAYMENTS_CASH_ENABLED=true
PAYMENTS_TELEBIRR_ENABLED=false

# Telebirr (leave unset until merchant onboarding is complete — adapter stays in sandbox mode)
# TELEBIRR_APP_ID=
# TELEBIRR_APP_KEY=
# TELEBIRR_SHORT_CODE=
# TELEBIRR_PUBLIC_KEY=
# TELEBIRR_PRIVATE_KEY=
# TELEBIRR_API_URL=https://app.ethiomobilemoney.et:2121
# TELEBIRR_NOTIFY_URL=
# TELEBIRR_RECEIVE_NAME=Betegna

# Cancellation policy (defaults shown)
PAYMENTS_FREE_CANCEL_HOURS=24
PAYMENTS_LATE_FEE_PCT=10
PAYMENTS_PLATFORM_FEE_PCT=12

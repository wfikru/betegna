rules_version = '2';

/**
 * Betegna Firestore Security Rules
 *
 * Principles:
 *  - One account, two roles: `customer` and/or `professional` on users/{uid}.roles
 *  - Users access only their own requests/quotes/conversations/bookings/payments
 *  - Professionals access only leads assigned to them
 *  - Sensitive operations (payment capture, reputation aggregation, notifications
 *    fan-out) happen in Cloud Functions with Admin SDK — never trusted to clients
 *  - The client is treated as untrusted; server-side validation mirrors these rules
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* ── helpers ── */
    function isSignedIn() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }
    function hasRole(role) {
      return isSignedIn() && role in userDoc().roles;
    }
    function isSelf(userId) {
      return isSignedIn() && uid() == userId;
    }
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    /* ── users ── */
    match /users/{userId} {
      allow get: if isSelf(userId); // profiles resolved server-side (search)
      allow create: if isSelf(userId) // signup writes its own profile once
        && request.resource.data.roles is list
        && request.resource.data.roles.size() <= 2
        && request.resource.data.activeRole in request.resource.data.roles;
      allow update: if isSelf(userId)
        && unchanged('email')
        && request.resource.data.roles is list
        && request.resource.data.roles.size() <= 2;
      allow delete: if false; // account deletion runs server-side (data cleanup)
    }

    /* ── professional profiles (public directory) ── */
    match /professionals/{proId} {
      allow read: if true; // customers browse professionals
      allow create, update: if isSelf(proId) && hasRole('professional')
        && request.resource.data.rating == resource.data.rating || resource == null;
      allow delete: if false;
    }

    /* ── taxonomy (admin-managed, world-readable) ── */
    match /categories/{doc} { allow read: if true; allow write: if false; }
    match /services/{doc} { allow read: if true; allow write: if false; }
    match /serviceQuestions/{doc} { allow read: if true; allow write: if false; }

    /* ── service requests ── */
    match /serviceRequests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.customerId == uid()
        && request.resource.data.status == 'submitted'
        && request.resource.data.matchedProIds.size() == 0;
      allow read: if isSignedIn()
        && (resource.data.customerId == uid()
            || resource.data.matchedProIds.hasAny([uid()])); // matched pros can read the request they were matched to
      allow update: if isSignedIn()
        && (resource.data.customerId == uid()
            || request.resource.data.matchedProIds.hasAny([uid()]))
        && unchanged('customerId');
      allow delete: if false;
    }

    /* ── leads: professionals see only their own ── */
    match /leads/{leadId} {
      allow read, update: if isSignedIn() && resource.data.proId == uid();
      allow create: if false; // fan-out writes happen in Cloud Functions only
      allow delete: if false;
    }

    /* ── quotes ── */
    match /quotes/{quoteId} {
      allow create: if isSignedIn()
        && request.resource.data.proId == uid()
        && hasRole('professional')
        && request.resource.data.status == 'sent';
      allow read: if isSignedIn()
        && (resource.data.customerId == uid() || resource.data.proId == uid());
      // status transitions: pro withdraw; customer accept/decline; CF does the rest
      allow update: if isSignedIn()
        && (
          (resource.data.proId == uid() && request.resource.data.status in ['withdrawn'])
          || (resource.data.customerId == uid() && request.resource.data.status in ['accepted', 'declined', 'change_requested'])
        )
        && unchanged('total')
        && unchanged('lines');
      allow delete: if false;
    }

    /* ── conversations & messages ── */
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && uid() in resource.data.participants;
      allow create: if isSignedIn() && uid() in request.resource.data.participants;
      allow update: if isSignedIn() && uid() in resource.data.participants
        && unchanged('customerId')
        && unchanged('proId');
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && uid() in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.senderId == uid()
          && request.resource.data.createdAt > 0;
        allow update: if isSignedIn()
          && request.resource.data.text == resource.data.text; // readBy / moderation only
        allow delete: if false;
      }
    }

    /* ── bookings ── */
    match /bookings/{bookingId} {
      allow read: if isSignedIn()
        && (resource.data.customerId == uid() || resource.data.proId == uid());
      allow create: if false; // created by Cloud Function on quote acceptance
      allow update: if isSignedIn()
        && (resource.data.customerId == uid() || resource.data.proId == uid())
        && unchanged('total')
        && unchanged('customerId')
        && unchanged('proId');
      allow delete: if false;
    }

    /* ── reviews ── */
    match /reviews/{reviewId} {
      allow read: if true; // public reputation
      allow create: if isSignedIn()
        && request.resource.data.customerId == uid()
        && request.resource.data.overall >= 1 && request.resource.data.overall <= 5;
      allow update: if isSignedIn()
        && resource.data.proId == uid()               // pro response
        && unchanged('overall');
      allow delete: if false; // moderation via admin
    }

    /* ── favorites ── */
    match /favorites/{favoriteId} {
      allow read, write: if isSignedIn()
        && request.resource.data.customerId == uid();
    }

    /* ── notifications ── */
    match /notifications/{notificationId} {
      allow read, update: if isSignedIn() && resource.data.uid == uid();
      allow create, delete: if false; // Cloud Functions only
    }

    /* ── payments (provider-agnostic: Telebirr + Cash; Cloud Functions only) ── */
    match /payments/{paymentId} {
      allow read: if isSignedIn()
        && (resource.data.payerUid == uid() || resource.data.payeeUid == uid());
      allow write: if false; // createPayment/telebirrNotify/confirmCashCollection CF only
    }

    /* ── disputes (admin) ── */
    match /disputes/{disputeId} {
      allow create: if isSignedIn()
        && request.resource.data.openedBy == uid();
      allow read: if isSignedIn()
        && (resource.data.openedBy == uid() || resource.data.against == uid());
      allow update: if false; // admin/CF only
    }

    /* ── reports ── */
    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reportedBy == uid();
      allow read, update, delete: if false; // admin only
    }

    /* ── availability & portfolio under professionals ── */
    match /portfolioItems/{itemId} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource.data.proId == uid();
    }

    /* ── everything else: denied by default ── */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  // Temporary rules: allow authenticated users to read/write.
  // This removes the prior time-based expiry condition blocking access.
  // TODO: Harden rules before production deployment.
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
